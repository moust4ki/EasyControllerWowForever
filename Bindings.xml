<Bindings>
    <Binding name="CONTROLLERKEYBOARD_TOGGLE" header="CONTROLLERKEYBOARD" category="ADDONS">
        ControllerKeyboard_Toggle()
    </Binding>
    <Binding name="CONTROLLERKEYBOARD_MAP" category="ADDONS">
        ControllerKeyboard_OpenMap()
    </Binding>
    <Binding name="CONTROLLERKEYBOARD_CONFIG" category="ADDONS">
        ControllerKeyboard_OpenConfig()
    </Binding>
    <Binding name="CLICK ControllerKeyboardWheelToggle:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel1:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel2:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel3:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel4:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel5:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel6:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel7:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardMyWheel8:LeftButton" category="ADDONS"/>
    <Binding name="CLICK ControllerKeyboardPhrasesToggle:LeftButton" category="ADDONS"/>
